#!/bin/sh
# Push a file/dir to burial's public share tree and emit the URL.
# Transport is tar over ssh to a forced-command key that can only write under
# /srv/www/jolo/<project>/; see the stash share cookbook for the burial side.
# Dotfiles are skipped at every depth, so .git, .env, .devcontainer never leak.

set -eu

target=${1:-}
if [ -z "$target" ]; then
    echo "share: usage: share <file-or-dir>" >&2
    exit 1
fi

if [ ! -e "$target" ]; then
    echo "share: not found: $target" >&2
    exit 1
fi

abs=$(realpath "$target")
base=${abs##*/}

case "$base" in
    .*) echo "share: refusing to share a dotfile: $base" >&2; exit 1 ;;
esac

parent=${abs%/*}
toplevel=$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || pwd)
project=${toplevel##*/}

key=${SHARE_SSH_KEY:-$HOME/.config/jolo/share-key}
if [ ! -r "$key" ]; then
    echo "share: no upload key at $key (host: ~/.config/jolo/share-key)" >&2
    exit 1
fi

tar --exclude='.*' -C "$parent" -cf - "$base" |
    ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes \
        -p "${SHARE_SSH_PORT:-5022}" \
        "${SHARE_SSH_USER:-share}@${SHARE_SSH_HOST:-burial.ts.glvortex.net}" \
        put "$project" "$base"

if [ -z "${SHARE_BASE_URL:-}" ]; then
    echo "→ jolo/$project/$base"
    echo "share: set SHARE_BASE_URL on the host for a URL" >&2
    exit 0
fi

# Directories need a trailing slash to resolve against the file server.
[ -d "$abs" ] && base="$base/"
url="$SHARE_BASE_URL/jolo/$project/$base"
printf '\033]52;c;%s\033\\' "$(printf '%s' "$url" | base64 -w0)"
echo "→ $url (clipboard)"
